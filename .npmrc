# ============================================================
# npm - Segurança
# ============================================================

# Registry oficial
registry=https://registry.npmjs.org/

# Manter package-lock.json
package-lock=true

# Não usar `save=false`: ele impede que o Dependabot (e o npm) gravem o
# package-lock.json ao atualizar dependências, deixando o lockfile dessincronizado.
# Para instalações locais sem gravar os manifestos, use `npm install --no-save`.

# Scripts de instalação: falha em qualquer dependência com script não listado
# no campo allowScripts do package.json. A política fica versionada no projeto
# (nao no ~/.npmrc de cada maquina), para CI e clones novos funcionarem.
strict-allow-scripts=true

# Exigir TLS válido
strict-ssl=true

# Manter auditoria habilitada
audit=true