# ===================================================================
# CONFIGURACAO DO AMBIENTE — PRODUCAO (docker-compose.prod.yml)
# ===================================================================
#
# Como usar no servidor Ubuntu:
#   cp .env.prod.example .env
#   # edite as senhas abaixo com valores fortes
#   docker compose -f docker-compose.prod.yml up -d --build
#
# IMPORTANTE:
#   - Troque TODAS as senhas (DB_ROOT_PASSWORD, DB_PASS) por valores
#     fortes e unicos antes de subir em producao.
#   - Este arquivo NAO deve ser versionado com valores reais.
#   - O compose falha se DB_ROOT_PASSWORD ou DB_PASS estiverem vazios
#     (variaveis marcadas com :?required).
# ===================================================================

# ---------- Banco de Dados ----------
# Senha root do MySQL (usada pelo compose para inicializar o banco)
DB_ROOT_PASSWORD=ALTERE_ESTA_SENHA_ROOT

# Nome / usuario / senha do banco da aplicacao
DB_NAME=cftv_gml
DB_USER=cftv_user
DB_PASS=ALTERE_ESTA_SENHA

# Tolerancia a MySQL reiniciando/subindo (subida inicial com volume novo).
DB_CONNECT_MAX_ATTEMPTS=10
DB_CONNECT_RETRY_DELAY_MS=500

# ---------- Aplicacao ----------
# Timezone
APP_TIMEZONE=America/Sao_Paulo

# Sessao (segundos)
SIGMON_SESSION_TIMEOUT=3600
SIGMON_SESSION_ABSOLUTE_TIMEOUT=28800

# CSP (0=strict, 1=permite inline styles)
SIGMON_CSP_ALLOW_INLINE_STYLES=0

# Sentry (opcional — em branco desativa error tracking)
SENTRY_DSN=

# ---------- Versionamento ----------
# Tag da imagem no registry e versao exibida no rodape do sistema.
# APP_VERSION tem prioridade; se vazio, usa APP_TAG (ou "latest").
APP_TAG=v1.0.0
APP_VERSION=v1.0.0

# ---------- Rede / Portas ----------
# Porta HTTP (redireciona 301 -> HTTPS) e porta HTTPS (TLS) no host.
# Exemplo para dividir o servidor com outros sistemas: HTTP em 8001 e
# HTTPS em 8000 (acesso: https://ip-do-servidor:8000). O redirect usa
# APP_HTTPS_PORT, entao o redirecionamento nao perde a porta.
APP_PORT=80
APP_HTTPS_PORT=443

# Origens CORS permitidas. Vazio = somente a propria origem (recomendado em intranet).
# Se necessario, use lista separada por virgula: https://sigmon.intranet.local
APP_ALLOWED_ORIGINS=

# IPs de proxy confiaveis (deixe vazio se sem proxy reverso externo).
# Ex.: se houver um load balancer/nginx externo fazendo terminação TLS.
PROXY_TRUSTED_IPS=

# ---------- Armazenamento ----------
# Diretório dos dados do MySQL no host (particao dedicada RAID6).
# Padrao para o servidor de producao: /mnt/sstv-sigmon/mysql
DB_DATA_PATH=/mnt/sstv-sigmon/mysql

# ---------- TLS (intranet) ----------
# O container termina TLS no proprio Nginx.
#  - Sem certificado montado: gera self-signed automaticamente (aviso no browser).
#    DECISAO: aceito para intranet; para producao publica use CA confiavel.
#  - Recomendado em intranet: instalar a CA interna nos clientes para evitar o aviso.
#    Com CA interna: copie para o volume "nginx_certs" os arquivos:
#        docker cp server.crt <container>:/etc/nginx/certs/server.crt
#        docker cp server.key <container>:/etc/nginx/certs/server.key
#    e reinicie: docker compose -f docker-compose.prod.yml restart app