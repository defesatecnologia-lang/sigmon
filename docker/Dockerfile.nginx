# ============================================
# Build stage — compilar assets (Vite)
# ============================================
FROM node:24-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.ts tsconfig.json postcss.config.js ./
COPY src/ src/
COPY public/ public/
COPY scripts/ scripts/
# O PurgeCSS (postcss.config.js) escaneia os arquivos PHP para decidir quais
# classes manter. Sem estes diretorios no contexto de build, todas as classes
# usadas apenas nos templates (.fa-*, .navbar-logo, .user-welcome-logo,
# .login-banner, ...) eram removidas do CSS de producao — resultando em icones
# ausentes e imagens sem tamanho definido.
COPY resources/ resources/
COPY inc/ inc/
COPY auth/ auth/
COPY accounts/ accounts/
RUN npm run build

# ============================================
# PHP-FPM + Nginx
# ============================================
FROM php:8.4-fpm

LABEL org.opencontainers.image.source="https://github.com/defesatecnologia-lang/sigmon"
LABEL org.opencontainers.image.description="Sistema de Gerenciamento de Cameras e Alarmes (Nginx)"
LABEL org.opencontainers.image.licenses="MIT"

ARG DEBIAN_FRONTEND=noninteractive

# RUN com pipe (curl | gpg, printf | sha256sum) exige pipefail.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Nginx 1.30.x do repo oficial: 1.30.7 corrige CVE-2026-123007/123633
# (HTTP/2) e CVE-2026-125283; 1.30.8 corrige CVE-2026-132779 (ssl_early_data).
# Atualizar NGINX_VERSION, o checksum do tarball e os commits do modulo abaixo
# em conjunto quando uma nova versao 1.30 for publicada.
ARG NGINX_VERSION=1.30.8

# apt-get upgrade aplica atualizacoes de seguranca dos pacotes ja presentes na
# imagem base (ex.: linux-libc-dev), evitando CVEs abertos no Trivy image scan.
# hadolint ignore=DL3008
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        curl gnupg2 ca-certificates \
    && mkdir -p /root/.gnupg && chmod 700 /root/.gnupg \
    && curl -fsSL https://nginx.org/keys/nginx_signing.key \
        | gpg --dearmor -o /usr/share/keyrings/nginx-archive-keyring.gpg \
    && gpg --dry-run --quiet --no-keyring --import --import-options import-show \
        /usr/share/keyrings/nginx-archive-keyring.gpg \
        | grep -q '573BFD6B3D8FBC641079A6ABABF5BD827BD9BF62' \
    && echo 'deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] https://nginx.org/packages/debian trixie nginx' \
        > /etc/apt/sources.list.d/nginx.list \
    && printf 'Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n' \
        > /etc/apt/preferences.d/99nginx \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx openssl libpng-dev libzip-dev libonig-dev \
        libxml2-dev libcurl4-openssl-dev pkg-config libssl-dev \
        locales \
    && test "$(nginx -v 2>&1 | sed -n 's|.*nginx/\([0-9.]*\).*|\1|p')" = "$NGINX_VERSION" \
    && sed -i 's/# pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen \
    && locale-gen pt_BR.UTF-8 \
    && docker-php-ext-install pdo_mysql mbstring zip gd xml curl \
    && pecl install apcu && docker-php-ext-enable apcu \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# O repo nginx.org nao publica modulo Brotli pronto e o pacote Debian
# (libnginx-mod-http-brotli-static) e incompativel com a ABI do nginx 1.30.
# Compila-se ngx_http_brotli_static_module contra a mesma versao instalada.
ARG NGX_BROTLI_COMMIT=53e0fb55f250f48fe80c0ddbf6c0f7103cdbaae1
ARG BROTLI_COMMIT=db24a98aed38a16de78cc05ca15cdd8dc2a0d92d
WORKDIR /tmp
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libbrotli-dev libpcre2-dev zlib1g-dev git \
    && curl -fsSLO "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" \
    && printf '%s  %s\n' 'f867314ada32e717b949930859656c48a72dc6657aec598db58af2f98a40e1c1' "nginx-${NGINX_VERSION}.tar.gz" \
        | sha256sum -c - \
    && mkdir -p /tmp/nginx-src \
    && tar xzf "nginx-${NGINX_VERSION}.tar.gz" -C /tmp/nginx-src --strip-components=1 \
    && git clone -q https://github.com/google/ngx_brotli.git /tmp/ngx_brotli \
    && git -C /tmp/ngx_brotli checkout -q "$NGX_BROTLI_COMMIT" \
    && git -C /tmp/ngx_brotli submodule update --init -q \
    && git -C /tmp/ngx_brotli/deps/brotli checkout -q "$BROTLI_COMMIT" \
    && rm -rf /var/lib/apt/lists/*

# O configure do Nginx usa auto/*.sh relativos: precisa rodar dentro da fonte.
WORKDIR /tmp/nginx-src
RUN ./configure --with-compat --add-dynamic-module=/tmp/ngx_brotli \
    && make modules -j"$(nproc)" \
    && cp objs/ngx_http_brotli_static_module.so /etc/nginx/modules/

WORKDIR /
RUN rm -rf /tmp/ngx_brotli /tmp/nginx-src "/tmp/nginx-${NGINX_VERSION}.tar.gz" \
    && apt-get purge -y build-essential libbrotli-dev libpcre2-dev zlib1g-dev git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copiar composer e instalar dependencias PHP
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./

# Copiar codigo-fonte antes do composer install (classmap precisa do src/)
COPY . .

RUN composer install --no-interaction --optimize-autoloader --classmap-authoritative --no-dev

# Copiar assets buildados do stage de build (dist/.vite/manifest.json para o PHP;
# dist/assets/ para public/assets/ — docroot do Nginx serve /assets/*).
COPY --from=build /app/dist/ dist/
COPY --from=build /app/dist/assets/ public/assets/
# Webfonts self-host e lista de precache sao gerados no postbuild e gitignored.
# Sem este COPY o CSS do Font Awesome aponta para /assets/webfonts/*.woff2,
# o Nginx responde 404 e os icones do menu/grid nao renderizam.
COPY --from=build /app/public/assets/webfonts/ public/assets/webfonts/
COPY --from=build /app/public/sw-assets.json public/sw-assets.json

# Configuracoes PHP
RUN echo "memory_limit = 256M" > /usr/local/etc/php/conf.d/memory.ini \
    && echo "upload_max_filesize = 20M" > /usr/local/etc/php/conf.d/upload.ini \
    && echo "post_max_size = 20M" >> /usr/local/etc/php/conf.d/upload.ini \
    && echo "max_execution_time = 120" > /usr/local/etc/php/conf.d/timeout.ini \
    && echo "opcache.enable=1" > /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.revalidate_freq=2" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.enabled=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.shm_size=32M" >> /usr/local/etc/php/conf.d/opcache.ini

# Configurar PHP-FPM para ouvir na porta 9000
RUN sed -i 's|^listen = /run/php/php8.4-fpm.sock|listen = 9000|' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's|^;clear_env = no|clear_env = no|' /usr/local/etc/php-fpm.d/www.conf

# Copiar configuracao do Nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf
# Locations compartilhadas (incluidas dentro do server gerado pelo entrypoint)
COPY docker/locations.conf /etc/nginx/locations.conf
# Entrypoint (gera certs self-signed/CA e o bloco server HTTPS + redirect)
COPY docker/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
RUN chmod +x /usr/local/bin/nginx-entrypoint.sh

# Diretorio de certificados TLS (volume nomeado no compose) e tmpfs /run/nginx_conf
RUN mkdir -p /etc/nginx/certs /run/nginx_conf \
    && chown -R www-data:www-data /etc/nginx/certs /run/nginx_conf \
    && chmod 750 /etc/nginx/certs

# Diretorios de storage
RUN mkdir -p storage/ratelimit storage/cep_cache public/uploads \
    && chown -R www-data:www-data storage public/uploads \
    && chmod -R 755 storage public/uploads

ENV SIGMON_ENV=production
ARG APP_VERSION=dev
ENV APP_RELEASE_TAG=$APP_VERSION

# Remover default do Nginx (evitar conflito)
RUN rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx/body \
    && touch /run/php/php-fpm.pid /var/run/nginx.pid /var/log/nginx/access.log /var/log/nginx/error.log \
    && chown -R www-data:www-data /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx \
    && chown www-data:www-data /var/run/nginx.pid

EXPOSE 8080 8443

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["curl", "-kfsS", "https://localhost:8443/"]

# Rodar como uid 33 (www-data, nao root) — nginx master + php-fpm
USER 33:33

CMD ["/usr/local/bin/nginx-entrypoint.sh"]
